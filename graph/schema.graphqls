# This file defines the GraphQL schema for a simple movie database.
# O Contrato: it defines the types, queries, and mutations that clients can use to interact with the movie data.
# Like a Swagger (IService) in C#, it serves as a blueprint for the API, specifying the structure of the data and the operations that can be performed on it.

type Movie {
    id: ID!
    title: String!
    genre: String!
}

# The NewMovie input type is used for creating new movie entries. It requires a title and genre, but does not include an ID since that will be generated by the server.
# I need this input type to ensure that clients provide the necessary information when adding a new movie, while keeping the ID generation logic on the server side.
input NewMovie {
    title: String!
    genre: String!
}

type Query {
    movies: [Movie!]!
}

# The Mutation type defines the operations that can modify the data. In this case, we have an addMovie mutation that takes a NewMovie input and returns the newly created Movie object.
type Mutation {
    addMovie(input: NewMovie!): Movie!
}